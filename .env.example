# Active Spring profile: local | dev | uat | prod
SPRING_PROFILES_ACTIVE=local

# HTTP port the service binds to (QCP container standard: 9942)
SERVER_PORT=8080

# SYSTEM (superadmin) database — tenant registry lives here.
# The user needs CREATEDB + CREATEROLE so tenant DBs can be provisioned at runtime.
DB_URL=jdbc:postgresql://localhost:5432/diy-batch-upload-db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Host/port seeded into the registry db_url values (tenant DBs live on the same server)
DB_HOST=localhost
DB_PORT=5432

# Per-tenant DB credentials (relaxed binding → qcp.multitenancy.tenants.<code>.*)
# One pair per tenant short code; Vault replaces these on real environments.
QCP_MULTITENANCY_TENANTS_QC_DBUSERNAME=qc_user
QCP_MULTITENANCY_TENANTS_QC_DBPASSWORD=qc_pass
QCP_MULTITENANCY_TENANTS_CLIENT1_DBUSERNAME=client1_user
QCP_MULTITENANCY_TENANTS_CLIENT1_DBPASSWORD=client1_pass
QCP_MULTITENANCY_TENANTS_CLIENT2_DBUSERNAME=client2_user
QCP_MULTITENANCY_TENANTS_CLIENT2_DBPASSWORD=client2_pass

# ==================== Identity ====================
# Two ways a service from this template gets its identity, and they are configured differently.
# RUN-WITH-IDENTITY-PORTAL.md explains the choice; this is the shape of it.
#
# KEYCLOAK_SERVER_URL must be an address a BROWSER can reach. An internal container name makes
# Keycloak describe itself by that name in its discovery document, and sign-in dies at a
# redirect the browser cannot resolve. This one is required either way.
# 8081, not 8080 — SERVER_PORT above already claims 8080 for this app when run with
# `mvn spring-boot:run`. docker-compose.yml runs Keycloak on the same 8081 host port; the app
# container itself reaches it as http://keycloak:8080 (internal Docker network), not this value.
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
#
# (a) a Keycloak of this service's own, one realm per tenant — leave KEYCLOAK_PLATFORM_TENANT
#     blank; the realm is then the tenant code and the issuer is what separates tenants.
#     KEYCLOAK_REALM is then only the fallback realm for system/admin-scope requests (no tenant
#     subdomain) and MUST match KEYCLOAK_SUPER_ADMIN_REALM below — see application-local.yaml.
#     script/keycloak/import/ provisions admin-local, qc, client1, client2 realms to match the
#     tenant registry (V1_1_20__seed_tenants.sql) plus one admin-local realm for system scope.
# (b) identity-portal-service issues the tokens — one realm per platform tenant, one client per
#     application tenant. Set both: the realm the portal provisioned, and the platform tenant
#     code. Setting the platform tenant switches audience checking on, which is what separates
#     two application tenants that now share a realm. Tenant short codes in the registry must
#     then be the portal's APPLICATION TENANT codes, spelled exactly as the portal spells them.
#     See RUN-WITH-IDENTITY-PORTAL.md.
KEYCLOAK_REALM=admin-local
KEYCLOAK_SUPER_ADMIN_REALM=admin-local
KEYCLOAK_PLATFORM_TENANT=

# Hostname the tenant is resolved from: {tenant}-{product}-{env}.{base-domain}. `product` has no
# default in the template on purpose — set it here or in application.yaml. Environment blank
# means "use the active profile", which is right for a deployed environment.
QCP_HOST_PRODUCT=
QCP_HOST_ENVIRONMENT=

# CORS origin *patterns*, comma-separated. One pattern covers every tenant under the subdomain
# convention. Get this wrong and sign-in fails in the browser with a bare CORS error and nothing
# useful on the server; the effective list is logged at INFO on startup for that reason.
QCP_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=https://*-<product>-dev.qualtechedge.in

# Vault. Off is a valid starting point — a new project can deploy before it has a Vault.
VAULT_ENABLED=false

# LOCAL-DEV-ONLY escape hatch (DevBypassAuthenticationFilter): when true, any request with no
# Authorization header is authenticated as a trusted admin actor instead of being rejected —
# lets the maker-checker admin API be exercised without a running Keycloak. Override the actor
# with the X-Dev-Actor-Id / X-Dev-Actor-Role request headers. NEVER set this true anywhere but
# a machine you're developing on — leave unset/false once real auth is wired up.
APP_SECURITY_DEV_BYPASS_ENABLED=false

# Optional HikariCP overrides (system datasource)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ==================== Batch upload validation (Plan 1: config lock) ====================
# Base URL validation-service's REST API is reachable at, used to pull row-wise results
# (ValidationServiceResultsClient) once its validation-completed callback arrives at
# POST /api/v1/batch-uploads/{batchId}/validation-completed (controller.BatchUploadController) —
# the reverse direction, validation-service calling in, has no env var here; it's configured on
# validation-service's own side (its DIY_UPLOAD_SERVICE_BASE_URL).
VALIDATION_SERVICE_BASE_URL=http://localhost:9943
# processes.config_locked is force-released if held longer than this (ConfigLockReaper) — covers
# validation-service crashing mid-batch and never publishing its completion event.
STALE_LOCK_TIMEOUT_MINUTES=60

# JVM tuning passed by start.sh
JAVA_OPTS=-Xms256m -Xmx512m
